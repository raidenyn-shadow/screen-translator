<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Fully invisible activity chrome: the trampoline must not flash or animate on screen. -->
    <style name="Theme.ScreenTranslator.Trampoline" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- The real setup page: a normal opaque window, unlike the invisible trampoline. -->
    <style name="Theme.ScreenTranslator.Setup" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.ScreenTranslator.Capture" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
